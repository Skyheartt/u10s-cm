# Service account from https://www.trackmania.com/player/service-accounts
# Use a spare Ubisoft account, not the one you play on.
NADEO_LOGIN=
NADEO_PASSWORD=

# OAuth app from https://api.trackmania.com (client credentials, for display names)
TM_CLIENT_ID=
TM_CLIENT_SECRET=

# Sent with every request so Nadeo can see who is calling.
# Put an email or Discord you actually read.
CONTACT=
